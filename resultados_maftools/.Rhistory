library(tidyverse)
inconsistencias <- dados %>%
filter(
IDADE >= "401" &
IDADEMAE != "" &
!is.na(IDADEMAE)
)
total_casos <- nrow(inconsistencias)
cat("a. Em quantos registros do conjunto de dados há inconsistências?\n")
cat("Resposta: Há", total_casos, "registros com inconsistências.\n\n")
cat("b. Exemplo de inconsistência detectada:\n")
if (total_casos > 0) {
exemplo <- inconsistencias %>%
select(contador, IDADE, IDADEMAE) %>%
slice(1)
print(exemplo)
} else {
cat("Nenhuma inconsistência foi encontrada com os critérios aplicados.\n")
}
