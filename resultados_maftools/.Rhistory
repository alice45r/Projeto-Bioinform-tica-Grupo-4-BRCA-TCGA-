library(tidyverse)
# --- LETRA a ---
mulheres_idade_fertil <- dados %>%
filter(
SEXO == "2" &
IDADE >= "410" &
IDADE <= "449"
)
total_idade_fertil <- nrow(mulheres_idade_fertil)
cat("a. Definição: Assume-se como 'mulher em idade fértil' a faixa etária de 10 a 49 anos de idade do sexo feminino.\n")
cat("Quantidade de óbitos que atendem a essa definição:", total_idade_fertil, "\n\n")
# --- LETRA b ---
preenchimento_inadequado <- dados %>%
filter(
(SEXO != "2" | IDADE < "410" | IDADE > "449") &
(TPMORTEOCO != "" & !is.na(TPMORTEOCO) & TPMORTEOCO != "0" & TPMORTEOCO != "9")
)
total_inadequado <- nrow(preenchimento_inadequado)
cat("b. Quantidade de registros com preenchimento inadequado:", total_inadequado, "\n\n")
# --- LETRA c ---
cat("c. Exemplo de preenchimento inadequado:\n")
if (total_inadequado > 0) {
exemplo_c <- preenchimento_inadequado %>%
select(contador, SEXO, IDADE, TPMORTEOCO) %>%
slice(1)
print(exemplo_c)
} else {
cat("Nenhum registro com preenchimento inadequado foi detectado.\n")
}
cat("\n")
# --- LETRA d ---
deveria_ter_preenchido <- mulheres_idade_fertil %>%
filter(TPMORTEOCO == "" | is.na(TPMORTEOCO) | TPMORTEOCO == "9" | TPMORTEOCO == "0")
total_nao_preenchido <- nrow(deveria_ter_preenchido)
cat("d. Quantidade de registros que deveriam ter sido preenchidos e não foram:", total_nao_preenchido, "\n\n")
# --- LETRA e ---
cat("e. Exemplo de registro que ficou sem o preenchimento devido:\n")
if (total_nao_preenchido > 0) {
exemplo_e <- deveria_ter_preenchido %>%
select(contador, SEXO, IDADE, TPMORTEOCO) %>%
slice(1)
print(exemplo_e)
} else {
cat("Nenhum registro omisso foi detectado.\n")
}
#| message: false
#| warning: false
library(tidyverse)
homicidios <- dados %>%
filter(CIRCOBITO == "3")
homicidios <- homicidios %>%
mutate(
idade_anos = case_when(
startsWith(IDADE, "4") ~ as.numeric(IDADE) - 400,
startsWith(IDADE, "3") ~ 0, # Meses -> menor que 1 ano (0 anos)
startsWith(IDADE, "2") ~ 0, # Dias -> menor que 1 ano (0 anos)
startsWith(IDADE, "1") ~ 0, # Horas -> menor que 1 ano (0 anos)
TRUE ~ NA_real_
)
)
# --- RESPOSTA DA LETRA A ---
grupo_branca_amarela <- homicidios %>%
filter(RACACOR %in% c("1", "3")) %>%
nrow()
grupo_pretas_pardas_indigenas <- homicidios %>%
filter(RACACOR %in% c("2", "4", "5")) %>%
nrow()
cat("a. Quantidade de vítimas de homicídio por grupos de raça/cor:\n")
cat("- Branca ou Amarela:", grupo_branca_amarela, "vítimas.\n")
cat("- Preta, Parda ou Indígena:", grupo_pretas_pardas_indigenas, "vítimas.\n\n")
# --- RESPOSTA DA LETRA B ---
homicidios_grafico <- homicidios %>%
filter(RACACOR %in% c("1", "2", "3", "4", "5")) %>%
mutate(
Raça = case_when(
RACACOR == "1" ~ "Branca",
RACACOR == "2" ~ "Preta",
RACACOR == "3" ~ "Amarela",
RACACOR == "4" ~ "Parda",
RACACOR == "5" ~ "Indígena"
)
)
# Gerando o gráfico boxplot
ggplot(homicidios_grafico, aes(x = Raça, y = idade_anos, fill = Raça)) +
geom_boxplot(alpha = 0.7) +
labs(
title = "Distribuição de Idade das Vítimas de Homicídio (2024)",
x = "Categoria de Raça/Cor",
y = "Idade (em anos)"
) +
theme_minimal() +
theme(legend.position = "none")
